{
  "schemaVersion": 1,
  "id": "starac",
  "version": "${version}",

  "name": "Staráč",
  "description": "Modernizes Minecraft Beta libraries for the best experience on modern OSes",
  "authors": [
    "Slainlight",
    "DanyGames2014"
  ],

  "license": ["MIT", "LGPL-2.1-only"],
  "icon": "assets/starac/icon.png",

  "environment": "*",
  "accessWidener": "starac.accessWidener",
  "entrypoints": {
