{
  "schemaVersion": 1,
  "id": "gambac",
  "version": "${version}",

  "name": "Gambac",
  "description": "deAWTs the game, fixes colors being inverted on Apple Silicon chips, and provides LWJGL3 support via GLFW",
  "authors": [
    "DanyGames2014"
  ],

  "license": "MIT",
  "icon": "assets/gambac/icon.png",

  "environment": "*",
  "accessWidener": "gambac.accessWidener",
  "entrypoints": {
    "preLaunch": [
      "net.danygames2014.gambac.GambacPreLaunch"
    ],
    "stationapi:event_bus": [
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ]
  },
  "mixins": [
    "gambac.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "java": ">=17"
  }
}
